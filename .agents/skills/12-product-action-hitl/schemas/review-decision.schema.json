{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Action HITL Decision Manifest",
  "$comment": "Semantic validation must enforce that reviewed_action_ids equals the disjoint union of all item-decision ID arrays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_gate",
    "run_id",
    "overall_status",
    "reviewed_action_ids",
    "approved_action_ids",
    "rejected_action_ids",
    "revision_action_ids",
    "deferred_action_ids",
    "reviewer",
    "reviewed_at",
    "reviewer_summary",
    "synthetic"
  ],
  "properties": {
    "review_gate": {
      "const": "product-action-hitl"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "overall_status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "CHANGES_REQUIRED",
        "REJECTED"
      ]
    },
    "reviewed_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "approved_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "rejected_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "revision_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "reviewer_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "deferred_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision_action_ids": {
            "minItems": 1
          }
        },
        "required": [
          "revision_action_ids"
        ]
      },
      "then": {
        "properties": {
          "overall_status": {
            "const": "CHANGES_REQUIRED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "CHANGES_REQUIRED"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "revision_action_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_status": {
            "const": "APPROVED"
          }
        },
        "required": [
          "overall_status"
        ]
      },
      "then": {
        "properties": {
          "revision_action_ids": {
            "maxItems": 0
          },
          "reviewer": {
            "type": "string",
            "minLength": 1
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "reviewer_summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
