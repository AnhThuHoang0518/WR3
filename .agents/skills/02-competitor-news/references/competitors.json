{
  "schema_version": "1.0",
  "dataset_name": "VSF Smart City Competitors",
  "crawl_schedule": "WEEKLY",
  "competitor_count": 31,
  "post_crawl_filter": {
    "required_conditions": [
      "competitor_match"
    ],
    "keep_when": [
      "bài có thông tin liên quan đến hoạt động, dự án, sản phẩm, công nghệ, hợp tác, đầu tư, vận hành hoặc định vị của đối thủ",
      "bài về dự án Smart City",
      "bài về dự án bất động sản thông thường",
      "bài quảng cáo, mở bán, giới thiệu dự án hoặc truyền thông thương hiệu của đối thủ",
      "bài về xây dựng, hạ tầng, khu công nghiệp, đô thị, công nghệ hoặc dịch vụ liên quan đến đối thủ"
    ],
    "reject_when": [
      "chỉ là tin tuyển dụng",
      "chỉ là biến động cổ phiếu, mã chứng khoán hoặc kết quả giao dịch",
      "chỉ nhắc tên đối thủ nhưng nội dung thực tế không liên quan đến doanh nghiệp",
      "bài trùng lặp hoặc không có nội dung hữu ích"
    ],
    "output_labels": [
      "RELEVANT",
      "IRRELEVANT",
      "NEEDS_REVIEW"
    ]
  },
